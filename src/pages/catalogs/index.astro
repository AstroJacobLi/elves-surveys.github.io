---
import BaseLayout from '../../layouts/BaseLayout.astro';
import docs from '../../content/data-docs.json';
---

<BaseLayout
  title="Data documentation | ELVES Surveys"
  description="Column and field documentation for the public ELVES survey data products."
>
  <section class="hero hero--survey">
    <div class="survey-hero__copy">
      <p class="eyebrow">Public data</p>
      <h1>Data documentation</h1>
      <p class="hero__lede">
        One page per survey, describing every released data product: what each file contains, how to read it,
        and what every column or field means.
      </p>
    </div>
  </section>

  <section class="page-section page-section--after-compact-hero" aria-labelledby="docs-heading">
    <div class="section-heading">
      <p class="eyebrow">Released</p>
      <h2 id="docs-heading">Documented surveys</h2>
    </div>
    <div class="release-grid">
      {
        docs.map((doc) => (
          <article class="release-card">
            <p class="eyebrow">{doc.version} · {doc.releaseDate}</p>
            <h3><a class="text-link" href={`/catalogs/${doc.survey}/`}>{doc.surveyName}</a></h3>
            <p>{doc.intro}</p>
            <ul class="doc-product-list">
              {doc.products.map((product) => (
                <li>
                  <a href={`/catalogs/${doc.survey}/#${product.id}`}>{product.name}</a>
                  <span>{product.format}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .release-card h3 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 650;
    line-height: 1.25;
  }

  .doc-product-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-2);
  }

  .doc-product-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-2);
  }

  .doc-product-list span {
    color: var(--color-muted);
    font-size: 0.9rem;
  }
</style>
