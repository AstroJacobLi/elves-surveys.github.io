---
import fs from 'node:fs';
import path from 'node:path';
import 'katex/dist/katex.min.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import docs from '../../../content/data-docs.json';

export function getStaticPaths() {
  return docs.flatMap((doc) =>
    (doc.tutorials ?? []).map((tutorial) => {
      const tutorialWithSurvey = {
        ...tutorial,
        survey: doc.survey,
        surveyName: doc.surveyName
      };
      return {
        params: { slug: tutorial.id },
        props: { tutorial: tutorialWithSurvey }
      };
    })
  );
}

const { tutorial } = Astro.props;
const renderedPath = path.join(process.cwd(), 'public', tutorial.renderedFile);
const hasRenderedNotebook = fs.existsSync(renderedPath);

const figureAlts = [
  'Color-magnitude diagram of the ELVES-Dwarf satellite sample with the photometric quenching boundary.',
  'ELVES-Dwarf quenched fraction versus stellar mass with 68 percent Jeffreys binomial intervals.'
];
let notebookHtml = '';
if (hasRenderedNotebook) {
  notebookHtml = fs.readFileSync(renderedPath, 'utf8');
  for (const alt of figureAlts) {
    notebookHtml = notebookHtml.replace(
      'alt="No description has been provided for this image"',
      `alt="${alt}"`
    );
  }
}
---

<BaseLayout
  title={`${tutorial.title} | ${tutorial.surveyName} tutorials`}
  description={tutorial.description}
>
  <section class="hero hero--tutorial">
    <div class="tutorial-hero__copy">
      <p class="eyebrow">{tutorial.surveyName} · Tutorial notebook</p>
      <h1>{tutorial.title}</h1>
      <p class="hero__lede">{tutorial.description}</p>
      <div class="hero__actions">
        <a class="button button--secondary" href={`/catalogs/${tutorial.survey}/#tutorials`}>
          Back to data documentation
        </a>
        <a class="button button--secondary" href={tutorial.notebookLink} download>
          Download .ipynb
        </a>
        {tutorial.colabLink && (
          <a
            class="button button--quiet"
            href={tutorial.colabLink}
            target="_blank"
            rel="noopener noreferrer"
          >
            Open in Colab <span aria-hidden="true">↗</span>
          </a>
        )}
      </div>
    </div>
    <aside class="tutorial-hero__note" aria-label="Notebook format">
      <p class="tutorial-hero__note-label">Static notebook view</p>
      <p>
        The code has already been run. Outputs and figures below are fixed to the published
        data release; download the notebook to change parameters or rerun cells.
      </p>
      <p class="tutorial-hero__requirements">{tutorial.requirements}</p>
    </aside>
  </section>

  <section class="page-section notebook-section" aria-label={`${tutorial.title} rendered notebook`}>
    {
      hasRenderedNotebook ? (
        <article class="notebook-render" data-notebook-render set:html={notebookHtml} />
      ) : (
        <div class="notebook-unavailable" role="status">
          <p>
            Rendered notebook is not available in this build. Please download the notebook above and
            run it locally.
          </p>
        </div>
      )
    }
  </section>
</BaseLayout>

<script>
  import renderMathInElement from 'katex/contrib/auto-render';

  const notebook = document.querySelector('[data-notebook-render]');
  if (notebook) {
    renderMathInElement(notebook, {
      delimiters: [
        { left: '$$', right: '$$', display: true },
        { left: '$', right: '$', display: false },
        { left: '\\[', right: '\\]', display: true },
        { left: '\\(', right: '\\)', display: false }
      ],
      ignoredTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code'],
      throwOnError: false
    });
  }
</script>

<style>
  .hero--tutorial {
    align-items: start;
    gap: var(--space-7);
    padding-bottom: var(--section-space-compact);
  }

  .tutorial-hero__copy {
    display: grid;
    gap: var(--space-4);
  }

  .tutorial-hero__note {
    display: grid;
    gap: var(--space-3);
    border-left: 3px solid var(--color-accent);
    background: var(--color-accent-soft);
    color: var(--color-muted);
    padding: var(--space-4) var(--space-5);
    line-height: var(--line-height-body);
  }

  .tutorial-hero__note-label {
    color: var(--color-accent-strong);
    font-size: 0.76rem;
    font-weight: var(--font-weight-meta);
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .tutorial-hero__requirements {
    color: var(--color-subtle);
    font-size: 0.82rem;
  }

  .notebook-section {
    padding-top: var(--section-space-compact);
  }

  .notebook-render {
    width: min(100%, 980px);
    margin-inline: auto;
    color: var(--color-text);
  }

  .notebook-unavailable {
    width: min(100%, 980px);
    margin-inline: auto;
    border-left: 3px solid var(--color-border-strong);
    background: var(--color-surface-soft);
    color: var(--color-muted);
    padding: var(--space-4) var(--space-5);
  }

  .notebook-render :global(.cell) {
    min-width: 0;
    margin: 0 0 var(--space-6);
  }

  .notebook-render :global(.text_cell_render) {
    max-width: 76ch;
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  .notebook-render :global(.text_cell_render h2) {
    margin: var(--space-7) 0 var(--space-3);
    color: var(--color-text);
    font-size: var(--font-size-h2-compact);
    line-height: var(--line-height-heading);
  }

  .notebook-render :global(.text_cell_render p),
  .notebook-render :global(.text_cell_render ol),
  .notebook-render :global(.text_cell_render ul) {
    margin: 0 0 var(--space-3);
  }

  .notebook-render :global(.text_cell_render li + li) {
    margin-top: var(--space-1);
  }

  .notebook-render :global(.anchor-link) {
    margin-left: var(--space-2);
    color: var(--color-subtle);
    font-size: 0.75em;
    text-decoration: none;
    opacity: 0;
  }

  .notebook-render :global(h2:hover .anchor-link),
  .notebook-render :global(.anchor-link:focus-visible) {
    opacity: 1;
  }

  .notebook-render :global(.input_area) {
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    border-radius: 0 var(--radius-card) var(--radius-card) 0;
    background: #f7faf9;
    overscroll-behavior-x: contain;
  }

  .notebook-render :global(.input_area pre),
  .notebook-render :global(.output_subarea pre) {
    margin: 0;
    background: transparent;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.82rem;
    line-height: 1.6;
    tab-size: 4;
  }

  .notebook-render :global(.input_area pre) {
    min-width: max-content;
    padding: var(--space-4) var(--space-5);
  }

  .notebook-render :global(.output_wrapper) {
    margin-top: var(--space-3);
  }

  .notebook-render :global(.output_area + .output_area) {
    margin-top: var(--space-3);
  }

  .notebook-render :global(.output_subarea) {
    max-width: 100%;
    overflow-x: auto;
  }

  .notebook-render :global(.output_stream) {
    border-left: 3px solid var(--color-border-strong);
    background: var(--color-surface-soft);
    padding: var(--space-3) var(--space-4);
  }

  .notebook-render :global(.output_html) {
    color: var(--color-muted);
    font-size: 0.88rem;
  }

  .notebook-render :global(.output_html table) {
    width: max-content;
    min-width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  .notebook-render :global(.output_html th),
  .notebook-render :global(.output_html td) {
    border-bottom: 1px solid var(--color-border);
    padding: 0.45rem 0.65rem;
    text-align: right;
    white-space: nowrap;
  }

  .notebook-render :global(.output_html thead th) {
    background: var(--color-surface-soft);
    color: var(--color-text);
    font-weight: var(--font-weight-meta);
  }

  .notebook-render :global(.output_png) {
    display: flex;
    justify-content: center;
  }

  .notebook-render :global(.output_png img) {
    display: block;
    width: min(100%, 680px);
    height: auto;
  }

  .notebook-render :global(.kn),
  .notebook-render :global(.k),
  .notebook-render :global(.ow) {
    color: #7a3e9d;
  }

  .notebook-render :global(.s1),
  .notebook-render :global(.s2),
  .notebook-render :global(.sd) {
    color: #276b46;
  }

  .notebook-render :global(.mi),
  .notebook-render :global(.mf) {
    color: #075f9a;
  }

  .notebook-render :global(.nf),
  .notebook-render :global(.nb) {
    color: #9a4e00;
  }

  @media (max-width: 860px) {
    .hero--tutorial {
      gap: var(--space-5);
    }

    .tutorial-hero__note {
      padding: var(--space-4);
    }

    .notebook-render :global(.cell) {
      margin-bottom: var(--space-5);
    }

    .notebook-render :global(.text_cell_render h2) {
      margin-top: var(--space-6);
    }

    .notebook-render :global(.input_area pre) {
      padding: var(--space-3) var(--space-4);
      font-size: 0.76rem;
    }
  }
</style>
