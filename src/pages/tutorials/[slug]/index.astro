---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import docs from '../../../content/data-docs.json';

export function getStaticPaths() {
  return docs.flatMap((doc) =>
    (doc.tutorials ?? []).map((tutorial) => {
      const tutorialWithSurvey = {
        ...tutorial,
        survey: doc.survey,
        surveyName: doc.surveyName
      };
      return {
        params: { slug: tutorial.id },
        props: { tutorial: tutorialWithSurvey }
      };
    })
  );
}

const { tutorial } = Astro.props;
const renderedPath = path.join(process.cwd(), 'public', tutorial.renderedFile);

if (!fs.existsSync(renderedPath)) {
  throw new Error(
    `Rendered notebook not found at ${renderedPath}. Run npm run render:notebooks first.`
  );
}

const notebookHtml = fs.readFileSync(renderedPath, 'utf8');
if (!notebookHtml.includes('id="notebook-container"')) {
  throw new Error(`Rendered notebook at ${renderedPath} is not a native Jupyter HTML document.`);
}
const notebookSrc = `/${tutorial.renderedFile}`;
---

<BaseLayout
  title={`${tutorial.title} | ${tutorial.surveyName} tutorials`}
  description={tutorial.description}
>
  <section class="hero hero--tutorial">
    <div class="tutorial-hero__copy">
      <p class="eyebrow">{tutorial.surveyName} · Tutorial notebook</p>
      <h1>{tutorial.title}</h1>
      <p class="hero__lede">{tutorial.description}</p>
      <div class="hero__actions">
        <a class="button button--secondary" href={`/catalogs/${tutorial.survey}/#tutorials`}>
          Back to data documentation
        </a>
        <a class="button button--secondary" href={tutorial.notebookLink} download>
          Download .ipynb
        </a>
        {tutorial.colabLink && (
          <a
            class="button button--quiet"
            href={tutorial.colabLink}
            target="_blank"
            rel="noopener noreferrer"
          >
            Open in Colab <span aria-hidden="true">↗</span>
          </a>
        )}
      </div>
    </div>
    <aside class="tutorial-hero__note" aria-label="Notebook format">
      <p class="tutorial-hero__note-label">Static notebook view</p>
      <p>
        The code has already been run. Outputs and figures below are fixed to the published
        data release; download the notebook to change parameters or rerun cells.
      </p>
      <p class="tutorial-hero__requirements">{tutorial.requirements}</p>
    </aside>
  </section>

  <section class="page-section notebook-section" aria-label={`${tutorial.title} rendered notebook`}>
    <iframe
      class="notebook-frame"
      data-notebook-frame
      src={notebookSrc}
      title={`${tutorial.title} — rendered Jupyter notebook`}
      sandbox="allow-scripts"
      scrolling="no"
    ></iframe>
  </section>
</BaseLayout>

<script>
  const notebookFrames = [...document.querySelectorAll('[data-notebook-frame]')];

  window.addEventListener('message', (event) => {
    const frame = notebookFrames.find((candidate) => candidate.contentWindow === event.source);
    if (!frame || event.data?.type !== 'elves-notebook-height') return;

    const height = Number(event.data.height);
    if (!Number.isFinite(height)) return;
    frame.style.height = `${Math.min(Math.max(height, 640), 50000)}px`;
  });
</script>

<style>
  .hero--tutorial {
    align-items: start;
    gap: var(--space-7);
    padding-bottom: var(--section-space-compact);
  }

  .tutorial-hero__copy {
    display: grid;
    gap: var(--space-4);
  }

  .tutorial-hero__note {
    display: grid;
    gap: var(--space-3);
    border-left: 3px solid var(--color-accent);
    background: var(--color-accent-soft);
    color: var(--color-muted);
    padding: var(--space-4) var(--space-5);
    line-height: var(--line-height-body);
  }

  .tutorial-hero__note-label {
    color: var(--color-accent-strong);
    font-size: 0.76rem;
    font-weight: var(--font-weight-meta);
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .tutorial-hero__requirements {
    color: var(--color-subtle);
    font-size: 0.82rem;
  }

  .notebook-section {
    padding-top: var(--section-space-compact);
  }

  .notebook-frame {
    display: block;
    width: 100%;
    min-height: 80vh;
    border: 0;
    background: #fff;
  }

  @media (max-width: 860px) {
    .hero--tutorial {
      gap: var(--space-5);
    }

    .tutorial-hero__note {
      padding: var(--space-4);
    }

    .notebook-section {
      width: 100%;
    }
  }
</style>
