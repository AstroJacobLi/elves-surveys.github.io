---
const { products = [], tutorials = [], tone = 'default' } = Astro.props;

const isExternal = (value) => typeof value === 'string' && /^https?:\/\//.test(value);
const isLocal = (value) => typeof value === 'string' && value.startsWith('/');
const isUrl = (value) => isExternal(value) || isLocal(value);
const linkAttrs = (value) =>
  isExternal(value) ? { target: '_blank', rel: 'noopener noreferrer' } : { download: true };
const statusClass = (status) =>
  `status-pill${/available|released|public/i.test(status ?? '') ? ' status-pill--available' : ''}`;
const isReleased = (product) => /available|released|public/i.test(product.status ?? '') && isUrl(product.downloadLink);
const tutorialProducts = tutorials.map((tutorial) => ({
  ...tutorial,
  name: tutorial.title,
  version: 'Tutorial',
  releaseDate: 'Current',
  format: 'Jupyter notebook',
  downloadLink: tutorial.notebookLink,
  documentationLink: tutorial.viewerLink,
  citation: '',
  status: 'Available',
  kind: 'tutorial'
}));
const releasedProducts = [...products.filter(isReleased), ...tutorialProducts];
const plannedProducts = products.filter((product) => !isReleased(product));
const hasResources = products.length > 0 || tutorials.length > 0;
---

<section
  class:list={['data-products', { 'data-products--green': tone === 'green' }]}
  id="data"
  aria-labelledby="data-products-heading"
>
  <div class="section-heading">
    <p class="eyebrow">Public data</p>
    <h2 id="data-products-heading">Data products</h2>
    <p>
      If you use data products or tutorials from this survey, please cite the core survey paper and/or relevant science papers.
    </p>
  </div>

  {
    !hasResources ? (
      <p class="muted">No data products or tutorials are listed yet.</p>
    ) : (
      <>
        {releasedProducts.length > 0 && (
          <div class="data-table-wrap" role="region" aria-label="Released data products and tutorials" tabindex="0">
            <table class="data-table">
            <thead>
              <tr>
                <th scope="col">Product</th>
                <th scope="col">Release</th>
                <th scope="col">Description</th>
                <th scope="col">Format</th>
                <th scope="col">Access</th>
                <th scope="col">Citation</th>
              </tr>
            </thead>
            <tbody>
              {
                releasedProducts.map((product) => (
                  <tr>
                    <th scope="row">
                      <span class="product-name">{product.name}</span>
                      <span class="product-meta">{product.version}</span>
                      <span class={statusClass(product.status)}>{product.status}</span>
                    </th>
                    <td>{product.releaseDate}</td>
                    <td>{product.description}</td>
                    <td>
                      {product.format}
                      {product.kind === 'tutorial' && <span class="product-meta">{product.requirements}</span>}
                    </td>
                    <td>
                      <div class="resource-links resource-links--stacked">
                        {product.kind === 'tutorial' ? (
                          <>
                            <a href={product.documentationLink}>View tutorial</a>
                            {product.colabLink && (
                              <a href={product.colabLink} target="_blank" rel="noopener noreferrer">Open in Colab</a>
                            )}
                          </>
                        ) : (
                          <>
                            <a href={product.downloadLink} {...linkAttrs(product.downloadLink)}>Download</a>
                            {isUrl(product.documentationLink) ? (
                              <a href={product.documentationLink} {...(isExternal(product.documentationLink) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>Documentation</a>
                            ) : null}
                          </>
                        )}
                      </div>
                    </td>
                    <td>{product.citation}</td>
                  </tr>
                ))
              }
            </tbody>
            </table>
          </div>
        )}

        {releasedProducts.length > 0 && (
          <div class="product-card-list" aria-label="Released data products and tutorials">
            {
              releasedProducts.map((product) => (
                <article class="product-card">
                <div class="product-card__header">
                  <div>
                    <h3>{product.name}</h3>
                    <p>{product.description}</p>
                  </div>
                  <span class={statusClass(product.status)}>{product.status}</span>
                </div>
                <dl class="product-details">
                  <div>
                    <dt>Version</dt>
                    <dd>{product.version}</dd>
                  </div>
                  <div>
                    <dt>Release date</dt>
                    <dd>{product.releaseDate}</dd>
                  </div>
                  <div>
                    <dt>Format</dt>
                    <dd>
                      {product.format}
                      {product.kind === 'tutorial' && <span class="product-meta">{product.requirements}</span>}
                    </dd>
                  </div>
                </dl>
                <div class="resource-links">
                  {product.kind === 'tutorial' ? (
                    <>
                      <a href={product.documentationLink}>View tutorial</a>
                      <a href={product.downloadLink} download>Download .ipynb</a>
                      {product.colabLink && (
                        <a href={product.colabLink} target="_blank" rel="noopener noreferrer">Open in Colab</a>
                      )}
                    </>
                  ) : (
                    <>
                      <a href={product.downloadLink} {...linkAttrs(product.downloadLink)}>Download</a>
                      {isUrl(product.documentationLink) ? (
                        <a href={product.documentationLink} {...(isExternal(product.documentationLink) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>Documentation</a>
                      ) : null}
                    </>
                  )}
                </div>
                <p class="citation-note">{product.citation}</p>
                </article>
              ))
            }
          </div>
        )}

        {plannedProducts.length > 0 && (
          <div class="planned-products" aria-labelledby="planned-products-heading">
            <h3 id="planned-products-heading">Planned products</h3>
            <ul>
              {plannedProducts.map((product) => (
                <li>
                  <div>
                    <strong>{product.name}</strong>
                    <p>{product.description}</p>
                  </div>
                  {product.format && <span>{product.format}</span>}
                </li>
              ))}
            </ul>
          </div>
        )}
      </>
    )
  }
</section>

<style>
  .data-products--green .data-table-wrap {
    border-color: #c8ded7;
    box-shadow: 0 1px 3px rgba(15, 111, 97, 0.06);
  }

  .data-products--green .data-table thead th {
    background: #f5faf6;
  }

  .data-products--green .data-table tbody tr:hover {
    background: #fbfdfb;
  }

  .data-products--green .product-card {
    border-color: #c8ded7;
    background: linear-gradient(180deg, #f5faf6 0%, var(--color-surface) 38%);
    box-shadow: 0 1px 3px rgba(15, 111, 97, 0.06);
  }
</style>
