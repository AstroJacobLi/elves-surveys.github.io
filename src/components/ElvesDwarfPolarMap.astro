---
import { buildElvesDwarfPolarLayout } from '../lib/elvesDwarfPolarLayout.js';

const { hosts = [], caption = '' } = Astro.props;
const layout = buildElvesDwarfPolarLayout(hosts);
const plotHosts = [...layout.hosts].sort((a, b) => b.radius - a.radius);
const fmt = (value, digits = 2) => Number.isFinite(value) ? value.toFixed(digits) : '—';
const prettyName = (name) => {
  if (name.startsWith('NGC')) return `NGC ${Number(name.slice(3))}`;
  if (name.startsWith('IC')) return `IC ${Number(name.slice(2))}`;
  return name;
};
---

<figure class="polar-map" data-polar-map>
  <div class="polar-map__body">
    <div class="polar-map__plot">
      <svg
        viewBox="-5.8 -5.65 11.6 6.75"
        role="img"
        aria-labelledby="polar-map-title polar-map-description"
      >
        <title id="polar-map-title">ELVES-Dwarf systems across the Local Volume</title>
        <desc id="polar-map-description">
          Interactive fan diagram. Host distance sets radial position, circle size scales with
          virial radius, and satellite markers sit at projected host-centric radius. Focus or
          hover a host circle for its properties.
        </desc>
        <defs>
          <clipPath id="polar-fan-clip">
            <rect x={-layout.rOut - 0.04} y={-layout.rOut - 0.04} width={2 * layout.rOut + 0.08} height={layout.rOut + 0.08} />
          </clipPath>
          <radialGradient id="polar-distance-gradient">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0" />
            <stop offset="25%" stop-color="#ffffff" stop-opacity="0" />
            <stop offset="62%" stop-color="#e6f5eb" stop-opacity="0.2" />
            <stop offset="100%" stop-color="#d7efdf" stop-opacity="0.55" />
          </radialGradient>
        </defs>

        <g clip-path="url(#polar-fan-clip)">
          <circle class="polar-map__field" cx="0" cy="0" r={layout.rOut} />
          {
            layout.rings.map((distance) => (
              <circle
                class:list={['polar-map__ring', distance === layout.dMax && 'polar-map__ring--outer']}
                cx="0"
                cy="0"
                r={distance * layout.rpi}
                vector-effect="non-scaling-stroke"
              />
            ))
          }

          {
            plotHosts.map((host) => (
              <g
                class:list={[
                  'polar-host',
                  host.isLiterature && 'polar-host--literature',
                  !host.isolated && 'polar-host--nonisolated'
                ]}
                tabindex="0"
                role="button"
                aria-label={`${prettyName(host.name)}, log stellar mass ${fmt(host.logMstar)}, distance ${fmt(host.dist)} megaparsecs, ${host.counts.confirmed} confirmed and ${host.counts.unconfirmed} unconfirmed satellites`}
                data-name={prettyName(host.name)}
                data-distance={`${fmt(host.dist)} Mpc`}
                data-mass={fmt(host.logMstar)}
                data-confirmed={host.counts.confirmed}
                data-unconfirmed={host.counts.unconfirmed}
              >
                <title>{prettyName(host.name)}</title>
                <circle
                  class="polar-host__disc"
                  cx={host.x}
                  cy={-host.y}
                  r={host.radius}
                  vector-effect="non-scaling-stroke"
                />
                {
                  host.satellites.map((satellite) => {
                    const x = host.x + satellite.x;
                    const y = -(host.y + satellite.y);
                    if (satellite.status === 'Confirmed') {
                      return (
                        <circle
                          class="polar-satellite polar-satellite--confirmed"
                          cx={x}
                          cy={y}
                          r="0.055"
                          fill={satellite.color}
                          vector-effect="non-scaling-stroke"
                        />
                      );
                    }
                    if (satellite.status === 'Unconfirmed') {
                      return (
                        <path
                          class="polar-satellite polar-satellite--unconfirmed"
                          d={`M ${x - 0.05} ${y - 0.05} L ${x + 0.05} ${y + 0.05} M ${x + 0.05} ${y - 0.05} L ${x - 0.05} ${y + 0.05}`}
                          vector-effect="non-scaling-stroke"
                        />
                      );
                    }
                    return (
                      <circle
                        class="polar-satellite polar-satellite--not-observed"
                        cx={x}
                        cy={y}
                        r="0.055"
                        vector-effect="non-scaling-stroke"
                      />
                    );
                  })
                }
              </g>
            ))
          }
        </g>

        <g class="polar-map__axis">
          <line x1={-layout.rOut - 0.15} y1="0" x2={layout.rOut + 0.15} y2="0" vector-effect="non-scaling-stroke" />
          {
            [4, 8, 12].flatMap((distance) => [-1, 1].map((sign) => {
              const x = sign * distance * layout.rpi;
              return (
                <g>
                  <line x1={x} y1="0" x2={x} y2="0.12" vector-effect="non-scaling-stroke" />
                  <text x={x} y="0.34">{distance}</text>
                </g>
              );
            }))
          }
          <line x1="0" y1="0" x2="0" y2="0.12" vector-effect="non-scaling-stroke" />
          <text x="0" y="0.34">0</text>
          <text class="polar-map__axis-title" x="0" y="0.78">Distance [Mpc]</text>
        </g>
      </svg>
      <div class="polar-map__mass-key" aria-label="Satellite stellar-mass color scale">
        <span class="polar-map__mass-title">M★ satellite</span>
        <div class="polar-map__mass-scale">
          <span>10⁵</span><i aria-hidden="true"></i><span>10⁹ M☉</span>
        </div>
      </div>
      <div class="polar-tooltip" data-polar-tooltip role="status" aria-live="polite" hidden>
        <strong data-tooltip-name></strong>
        <dl>
          <div><dt>log M★/M☉</dt><dd data-tooltip-mass></dd></div>
          <div><dt>Distance</dt><dd data-tooltip-distance></dd></div>
          <div><dt>Confirmed</dt><dd data-tooltip-confirmed></dd></div>
          <div><dt>Unconfirmed</dt><dd data-tooltip-unconfirmed></dd></div>
        </dl>
      </div>
      <div class="polar-map__legend" aria-label="Figure legend">
        <ul>
          <li><span class="polar-key polar-key--elves"></span>ELVES-Dwarf host</li>
          <li><span class="polar-key polar-key--literature"></span>Literature host</li>
          <li><span class="polar-key polar-key--nonisolated"></span>Non-isolated host</li>
          <li><span class="polar-key polar-key--confirmed"></span>Confirmed satellite</li>
          <li><span class="polar-key polar-key--unconfirmed"></span>Unconfirmed</li>
          <li><span class="polar-key polar-key--not-observed"></span>Awaiting follow-up</li>
        </ul>
      </div>
    </div>
  </div>

  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  for (const root of document.querySelectorAll('[data-polar-map]')) {
    const groups = [...root.querySelectorAll('.polar-host')];
    const plot = root.querySelector('.polar-map__plot');
    const svg = root.querySelector('svg');
    const tooltip = root.querySelector('[data-polar-tooltip]');
    const field = (name) => tooltip.querySelector(`[data-tooltip-${name}]`);

    const positionTooltip = (clientX, clientY) => {
      const bounds = plot.getBoundingClientRect();
      const gap = 12;
      const edge = 8;
      let left = clientX - bounds.left + gap;
      let top = clientY - bounds.top + gap;

      if (left + tooltip.offsetWidth > bounds.width - edge) {
        left = clientX - bounds.left - tooltip.offsetWidth - gap;
      }
      if (top + tooltip.offsetHeight > bounds.height - edge) {
        top = clientY - bounds.top - tooltip.offsetHeight - gap;
      }

      tooltip.style.left = `${Math.max(edge, left)}px`;
      tooltip.style.top = `${Math.max(edge, top)}px`;
    };

    const positionAtHost = (group) => {
      const disc = group.querySelector('.polar-host__disc');
      const point = svg.createSVGPoint();
      point.x = Number(disc.getAttribute('cx'));
      point.y = Number(disc.getAttribute('cy'));
      const screen = point.matrixTransform(svg.getScreenCTM());
      positionTooltip(screen.x, screen.y);
    };

    const showHost = (group, event) => {
      groups.forEach((candidate) => candidate.toggleAttribute('data-active', candidate === group));
      field('name').textContent = group.dataset.name;
      field('mass').textContent = group.dataset.mass;
      field('distance').textContent = group.dataset.distance;
      field('confirmed').textContent = group.dataset.confirmed;
      field('unconfirmed').textContent = group.dataset.unconfirmed;
      tooltip.hidden = false;
      if (event?.clientX !== undefined) positionTooltip(event.clientX, event.clientY);
      else positionAtHost(group);
    };

    const hideHost = () => {
      groups.forEach((candidate) => candidate.removeAttribute('data-active'));
      tooltip.hidden = true;
    };

    groups.forEach((group) => {
      group.addEventListener('pointerenter', (event) => showHost(group, event));
      group.addEventListener('pointermove', (event) => positionTooltip(event.clientX, event.clientY));
      group.addEventListener('pointerleave', () => {
        if (document.activeElement !== group) hideHost();
      });
      group.addEventListener('focus', () => showHost(group));
      group.addEventListener('blur', hideHost);
      group.addEventListener('click', (event) => {
        group.focus({ preventScroll: true });
        showHost(group, event);
      });
    });
  }
</script>

<style>
  .polar-map {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }

  .polar-map__body {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: #fbfdff;
  }

  .polar-map__plot {
    position: relative;
    min-width: 0;
    padding: var(--space-3) var(--space-4) var(--space-2);
  }

  .polar-map svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .polar-map__field {
    fill: url('#polar-distance-gradient');
  }

  .polar-map__ring {
    fill: none;
    stroke: #c3cad4;
    stroke-width: 1px;
  }

  .polar-map__ring--outer {
    stroke: #9aa2ad;
    stroke-width: 1.4px;
  }

  .polar-map__axis {
    color: #5d6673;
    font-size: 0.22px;
    text-anchor: middle;
  }

  .polar-map__axis line {
    stroke: currentColor;
    stroke-width: 1.2px;
  }

  .polar-map__axis text {
    fill: currentColor;
  }

  .polar-map__axis-title {
    font-size: 0.27px;
    font-weight: 600;
  }

  .polar-host {
    cursor: pointer;
    outline: none;
  }

  .polar-host__disc {
    fill: rgba(65, 105, 225, 0.1);
    stroke: royalblue;
    stroke-width: 1.7px;
    transition: fill 120ms ease, stroke-width 120ms ease;
    pointer-events: visiblePainted;
  }

  .polar-host--literature .polar-host__disc {
    fill: rgba(255, 255, 255, 0.55);
    stroke: #858c96;
    stroke-width: 1.35px;
  }

  .polar-host--nonisolated .polar-host__disc {
    stroke-dasharray: 5 4;
  }

  .polar-host:hover .polar-host__disc,
  .polar-host:focus .polar-host__disc,
  .polar-host[data-active] .polar-host__disc {
    fill: rgba(65, 105, 225, 0.23);
    stroke-width: 3px;
  }

  .polar-host--literature:hover .polar-host__disc,
  .polar-host--literature:focus .polar-host__disc,
  .polar-host--literature[data-active] .polar-host__disc {
    fill: rgba(133, 140, 150, 0.16);
  }

  .polar-host:focus-visible .polar-host__disc {
    filter: drop-shadow(0 0 2px #ffffff) drop-shadow(0 0 2px var(--color-accent-strong));
  }

  .polar-satellite {
    pointer-events: none;
  }

  .polar-satellite--confirmed {
    stroke: #69717d;
    stroke-width: 1px;
  }

  .polar-satellite--unconfirmed {
    fill: none;
    stroke: #737b86;
    stroke-width: 1.4px;
  }

  .polar-satellite--not-observed {
    fill: #ffffff;
    stroke: #737b86;
    stroke-width: 1.2px;
  }

  .polar-tooltip {
    position: absolute;
    z-index: 3;
    display: grid;
    gap: var(--space-2);
    width: max-content;
    min-width: 178px;
    max-width: min(220px, calc(100% - 1rem));
    border: 1px solid var(--color-border-strong);
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.97);
    box-shadow: 0 4px 16px rgba(13, 23, 38, 0.14);
    padding: 0.55rem 0.65rem;
    font-size: 0.78rem;
    line-height: 1.3;
    pointer-events: none;
  }

  .polar-tooltip[hidden] {
    display: none;
  }

  .polar-tooltip strong {
    color: var(--color-text);
    font-size: 0.88rem;
  }

  .polar-tooltip dl {
    display: grid;
    gap: 0.2rem;
  }

  .polar-tooltip dl div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-4);
  }

  .polar-tooltip dt {
    color: var(--color-subtle);
  }

  .polar-tooltip dd {
    margin: 0;
    color: var(--color-text);
    font-weight: 600;
    text-align: right;
  }

  .polar-map__legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    padding-top: var(--space-2);
    color: var(--color-muted);
    font-size: 0.76rem;
  }

  .polar-map__legend ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .polar-map__legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .polar-key {
    display: inline-block;
    flex: none;
    width: 0.72rem;
    height: 0.72rem;
    border-radius: 50%;
  }

  .polar-key--elves {
    border: 2px solid royalblue;
    background: rgba(65, 105, 225, 0.12);
  }

  .polar-key--literature {
    border: 1.5px solid #858c96;
    background: white;
  }

  .polar-key--nonisolated {
    border: 1.5px dashed #858c96;
    background: white;
  }

  .polar-key--confirmed {
    width: 0.6rem;
    height: 0.6rem;
    border: 1px solid #69717d;
    background: #ef5b32;
  }

  .polar-key--unconfirmed {
    border-radius: 0;
    background:
      linear-gradient(45deg, transparent 43%, #737b86 44% 56%, transparent 57%),
      linear-gradient(-45deg, transparent 43%, #737b86 44% 56%, transparent 57%);
  }

  .polar-key--not-observed {
    border: 1.5px solid #737b86;
    background: white;
  }

  .polar-map__mass-key {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 2;
    display: grid;
    gap: 0.25rem;
    padding: 0.42rem 0.52rem;
    border: 1px solid rgba(152, 164, 181, 0.42);
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 2px 10px rgba(13, 23, 38, 0.08);
    color: var(--color-muted);
    font-size: 0.67rem;
    line-height: 1;
    pointer-events: none;
  }

  .polar-map__mass-title {
    color: var(--color-text);
    font-weight: 600;
  }

  .polar-map__mass-scale {
    display: grid;
    grid-template-columns: auto 4.2rem auto;
    align-items: center;
    gap: 0.3rem;
    white-space: nowrap;
  }

  .polar-map__mass-scale i {
    display: inline-block;
    width: 100%;
    height: 0.42rem;
    border-radius: var(--radius-pill);
    background: linear-gradient(
      90deg,
      rgb(255 0 0),
      rgb(255 98 50),
      rgb(254 181 98),
      rgb(190 236 142),
      rgb(126 255 181),
      rgb(63 235 213),
      rgb(1 179 236),
      rgb(66 95 250),
      rgb(128 0 255)
    );
  }

  .polar-map figcaption {
    color: var(--color-muted);
    font-size: 0.74rem;
    line-height: 1.4;
  }

  @media (max-width: 560px) {
    .polar-map__plot {
      padding-inline: var(--space-2);
    }

    .polar-map__legend ul {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: 100%;
      gap: var(--space-2);
    }

    .polar-map__mass-key {
      top: 0.5rem;
      left: 0.5rem;
      padding: 0.36rem 0.44rem;
    }

    .polar-map__mass-scale {
      grid-template-columns: auto 3.5rem auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .polar-host__disc {
      transition: none;
    }
  }
</style>
